# This file was generated using idf.py save-defconfig. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) 5.5.2 Project Minimal Configuration
#
CONFIG_ESP_TASK_WDT_TIMEOUT_S=15
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ONLY=y
CONFIG_BTDM_CTRL_MODE_BTDM=y
CONFIG_BTDM_CTRL_BLE_MAX_CONN=5
CONFIG_BTDM_CTRL_BR_EDR_MAX_ACL_CONN=5
CONFIG_BTDM_CTRL_AUTO_LATENCY=y
CONFIG_BTDM_CTRL_MODEM_SLEEP=n
CONFIG_XTAL_FREQ_AUTO=y
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y
CONFIG_MBEDTLS_PSK_MODES=y
CONFIG_MBEDTLS_KEY_EXCHANGE_PSK=y
CONFIG_BLUEPAD32_PLATFORM_CUSTOM=y
CONFIG_BLUEPAD32_MAX_DEVICES=1
# Debug로 올리면 HID 리포트마다 30줄씩 찍혀 UART가 막히고 btstack 런루프가 굶는다
CONFIG_BLUEPAD32_LOG_LEVEL_INFO=y
# GAP 보안 레벨 2를 요구하면 DualShock 3 계열(저가 클론 포함)이 연결에 실패한다.
# 레벨 0은 Nintendo Switch Pro를 제외한 모든 컨트롤러가 동작한다 (bluepad32 Kconfig 참고).
CONFIG_BLUEPAD32_GAP_SECURITY=n
CONFIG_BLUEPAD32_USB_CONSOLE_ENABLE=n
CONFIG_BLUEPAD32_ENABLE_BLE_BY_DEFAULT=n
CONFIG_RCCAR_BOARD_KINGTIGER_1_1=y
